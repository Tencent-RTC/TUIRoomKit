# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
stats.html

# Electron build output
# main/ and renderer/ are generated by scripts/build.mjs.
# Leading slash anchors these to the project root; otherwise the `main`
# pattern would also ignore electron/main (the main-process source) when
# this .gitignore ships with the published sample.
/main
/renderer
/release

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
